source "https://rubygems.org"

# github-pages pins Jekyll and every plugin to the versions GitHub Pages uses
group :jekyll_plugins do
    gem 'github-pages'
    gem 'jekyll-sitemap'
    gem 'jekyll-mentions'
    gem 'jekyll-seo-tag'
    gem 'jemoji'
    gem 'webrick' # required to run `jekyll serve` on Ruby 3+
end
